--[==[
================================================================================
 owh_loot_research.pluto
 Loot Multiplier RESEARCH HARNESS  —  READ-ONLY  —  v1.0.0
 Target runtime : OWH (Warframe Helper) LuaVM / Pluto  (diverifikasi pada
                  Pluto 0.13.1, basis Lua 5.5.1; ditulis dalam subset yang juga
                  valid untuk Lua 5.1 s.d. 5.5)
================================================================================

 KONTRAK KEAMANAN (baca sebelum dipakai)
 --------------------------------------------------------------------------------
 Skrip ini TIDAK dan TIDAK AKAN:
   [x] memasang hook apa pun (tidak ada MinHook/Detours/trampoline/jmp patch)
   [x] menulis / membaca memori proses game
   [x] memodifikasi register CPU (R12D, R8D, atau register lain)
   [x] melakukan patch instruksi (imul, mov, nop, dll)
   [x] mengubah hasil drop, jumlah loot, kredit, atau sumber daya aktual
   [x] melewati / menonaktifkan mekanisme anti-cheat
   [x] memanggil fungsi host yang tidak dikenal (hanya dicek keberadaannya)

 Yang skrip ini LAKUKAN:
   [o] Inventarisasi API: mendaftar global apa saja yang benar-benar tersedia
       di runtime OWH (bukti, bukan tebakan).
   [o] Mengklasifikasi anggota `owh` yang TERBUKTI ada (baca / tulis /
       kontrol / meta / ui) dan MENOLAK semua kelas tulis & kontrol lewat
       safe_owh(). Pengaman ada di kode, bukan cuma di komentar.
   [o] Pemodelan register 32-bit: mensimulasikan apa yang terjadi secara
       matematis bila sebuah nilai di-imul dengan faktor 2..5, termasuk
       overflow signed 32-bit.
   [o] Simulator x2..x5: menghitung hasil perkalian kuantitas dan probabilitas
       pada data drop sintetis yang kamu berikan sendiri.
   [o] Checklist alur data R12D: klaim yang bisa difalsifikasi + eksperimen
       yang dibutuhkan untuk membuktikannya.
   [o] Self-test + demonstrasi penanganan error.

 PENTING — PEMISAHAN STATUS (jangan dicampur):
   (1) RUNTIME SUCCESS  = skrip dimuat & dieksekusi tanpa error.
   (2) DIAGNOSTIC RESULT= angka/daftar yang dicetak skrip ini.
   (3) GAMEPLAY CHANGE  = perubahan loot nyata di dalam game.
   Skrip ini HANYA bisa memberikan (1) dan (2). Tidak ada satu baris pun di
   sini yang menghasilkan (3), dan (1)+(2) BUKAN bukti dari (3).

 Catatan sintaks: sengaja ditulis dalam subset Lua konservatif (tanpa goto,
 tanpa operator bitwise, tanpa //, tanpa fitur Pluto-only) agar portabel lintas
 VM. Semua akses ke fasilitas host dibungkus pcall + pemeriksaan type().
================================================================================
]==]

--------------------------------------------------------------------------------
-- 0. MODUL & KONFIGURASI
--------------------------------------------------------------------------------

local MODULE  = "owh_loot_research"
local VERSION = "1.2.0"

local CFG = {
    multipliers     = { 2, 3, 4, 5 },   -- target konfigurasi yang diteliti
    register_bits   = 32,               -- R12D = 32 bit  (R12W = 16, R12 = 64)
    register_signed = true,             -- imul signed
    mission_cap     = nil,              -- TIDAK DIKETAHUI. Isi hanya jika punya bukti.
    dump_limit      = 120,              -- maks entri global yang dicetak
    table_limit     = 60,               -- maks member per tabel yang dicetak
    write_report    = false,            -- true = coba simpan log ke file teks
    report_path     = "owh_loot_research.log",
    run_selftest    = true,             -- jalankan self-test saat dimuat
    run_on_load     = true,             -- false = hanya muat modul, jangan auto-run
    log_sink_mode   = "auto",           -- "auto" | "print" | "stderr" | "all" | "none"
    member_limit    = 200,              -- maks member per tabel host yang dicetak
    -- Mengizinkan pemanggilan kelas "read" dan "scan" SAJA (read_*,
    -- find_pattern, base, player_base). Kelas write/control/ui tetap dilarang
    -- tanpa kecuali, berapa pun nilai flag ini.
    -- Tetap MATI secara default: tanpa alamat yang sah dari RE-mu, memanggil
    -- read_* pada alamat ngawur bisa memicu crash pada proses game.
    call_readonly_probes = false,
}

-- Konstanta arsitektur x86-64 (fakta Intel/AMD SDM, bukan tebakan game)
local TWO_31 = 2147483648   -- 2^31
local TWO_32 = 4294967296   -- 2^32

--------------------------------------------------------------------------------
-- 1. UTILITAS AMAN  (tidak pernah melempar error keluar)
--------------------------------------------------------------------------------

--- Menjalankan f dengan argumen apa pun; mengembalikan ok, hasil|pesan error.
--  Dipakai untuk membungkus SEMUA pemanggilan yang tidak dijamin ada.
local function try(f, ...)
    if type(f) ~= "function" then
        return false, "objek yang dipanggil bukan function (tipe: " .. type(f) .. ")"
    end
    return pcall(f, ...)
end

--- tostring yang tidak pernah error (userdata bisa punya __tostring yang error).
local function tostr(v)
    local ok, s = pcall(tostring, v)
    if ok and type(s) == "string" then return s end
    return "<" .. type(v) .. ":tidak-dapat-dikonversi>"
end

--- Mengambil environment CHUNK saat ini (bukan selalu _G).
--  Pada VM tersemat, skrip sering dijalankan dengan env khusus; karena itu
--  pembacaan flag tidak boleh mengasumsikan _G sebagai satu-satunya env.
--  Urutan: _ENV (Lua 5.2+/Pluto) -> getfenv (Lua 5.1) -> _G.
local function current_env()
    if type(_ENV) == "table" then return _ENV end
    if type(getfenv) == "function" then
        local ok, e = pcall(getfenv, 1)
        if ok and type(e) == "table" then return e end
    end
    return _G
end

--- Membaca sebuah nama dari env chunk, lalu _G (mana pun yang lebih dulu ada).
--  Dipakai untuk flag DAN untuk pencarian global, karena VM tersemat bisa
--  saja menaruh namespace host di env khusus, bukan di _G.
local function lookup_global(name)
    local env = current_env()
    if type(env) == "table" then
        local v = rawget(env, name)
        if v ~= nil then return v end
    end
    if type(_G) == "table" then return rawget(_G, name) end
    return nil
end

--- Konversi aman ke number integer untuk keperluan format %d.
local function toint(v)
    local n = tonumber(v)
    if n == nil then return nil, "nilai bukan angka: " .. tostr(v) end
    if n ~= n then return nil, "nilai NaN" end
    if n == math.huge or n == -math.huge then return nil, "nilai tak hingga" end
    return math.floor(n)
end

--------------------------------------------------------------------------------
-- 2. SISTEM LOG MULTI-SINK
--    Skrip harus tetap berguna walau `print` tidak tersedia atau tidak terlihat.
--------------------------------------------------------------------------------

local LOG = {
    buffer  = {},      -- selalu terisi; bisa dibaca lewat M.get_log()
    max     = 2000,
    sinks   = nil,     -- diisi lazy oleh init_sinks()
}

local function push_line(line)
    if #LOG.buffer < LOG.max then
        LOG.buffer[#LOG.buffer + 1] = line
    end
end

--- Mendeteksi sink output yang BENAR-BENAR ada di runtime ini.
--  Hanya memakai fasilitas yang lolos pemeriksaan type(); tidak ada asumsi.
--
--  Mode "auto" (default) memilih SATU sink agar tidak terjadi duplikasi baris:
--  pada kebanyakan VM, print dan io.write keduanya berakhir di stdout, sehingga
--  memakai keduanya membuat setiap baris tercetak dua kali.
local function init_sinks()
    if LOG.sinks then return LOG.sinks end
    local mode   = CFG.log_sink_mode or "auto"
    local sinks  = {}
    local print_sink, err_sink = nil, nil

    if type(print) == "function" then
        print_sink = { name = "print", fn = function(s) print(s) end }
    end

    local ok, io_lib = pcall(function() return io end)
    if ok and type(io_lib) == "table" then
        local se = io_lib.stderr
        if type(se) == "table" and type(se.write) == "function" then
            err_sink = {
                name = "io.stderr",
                fn = function(s) pcall(function() se:write(s, "\n") end) end,
            }
        elseif type(io_lib.write) == "function" then
            err_sink = {
                name = "io.write",
                fn = function(s) pcall(io_lib.write, s, "\n") end,
            }
        end
    end

    if mode == "none" then
        -- hanya buffer
    elseif mode == "print" then
        if print_sink then sinks[#sinks + 1] = print_sink end
    elseif mode == "stderr" then
        if err_sink then sinks[#sinks + 1] = err_sink end
    elseif mode == "all" then
        if print_sink then sinks[#sinks + 1] = print_sink end
        if err_sink   then sinks[#sinks + 1] = err_sink   end
    else -- auto
        if print_sink then
            sinks[#sinks + 1] = print_sink
        elseif err_sink then
            sinks[#sinks + 1] = err_sink
        end
    end

    LOG.sinks = sinks
    return sinks
end

--- Mencetak satu baris ke semua sink yang tersedia. Tidak pernah melempar.
local function log(fmt, ...)
    local ok, line = pcall(string.format, fmt, ...)
    if not ok then
        -- string.format gagal atau tidak ada (mis. %d menerima non-integer,
        -- atau host mencabut string.format) -> fallback aman.
        -- Ambil argumen dulu ke tabel lokal: `...` tidak bisa dipakai di
        -- dalam closure pada Lua, jadi tidak boleh diakses dari fungsi gsub.
        local n, s = select("#", ...), tostring(fmt)
        local args = {}
        for i = 1, n do args[i] = tostr((select(i, ...))) end
        if type(string) == "table" and type(string.gsub) == "function" then
            -- Substitusi spesifier satu per satu agar baris tetap terbaca.
            local idx = 0
            line = string.gsub(s, "%%[-+ #0-9.]*[a-zA-Z%%]", function(spec)
                if spec == "%%" then return "%" end
                idx = idx + 1
                if idx <= n then return args[idx] end
                return spec
            end)
        else
            -- Jalan terakhir: tempelkan argumen di belakang teks format.
            line = s .. table.concat(args, " ")
        end
    end
    push_line(line)
    local sinks = init_sinks()
    for i = 1, #sinks do
        pcall(sinks[i].fn, line)
    end
    return line
end

local function rule(ch)
    log(string.rep(ch or "-", 78))
end

local function header(title)
    rule("=")
    log("%s", title)
    rule("=")
end

--------------------------------------------------------------------------------
-- 3. BAGIAN A — INVENTARISASI API RUNTIME (SUMBER BUKTI SATU-SATUNYA)
--------------------------------------------------------------------------------

--- Info versi VM. `pluto_*` hanya dilaporkan bila benar-benar ada.
local function detect_vm()
    local vv = rawget(_G, "_VERSION")
    local info = {
        _VERSION = (type(vv) == "string") and vv or "tidak tersedia",
        has_pluto_table = type(rawget(_G, "pluto")) == "table",
        has_debug       = type(rawget(_G, "debug")) == "table",
        has_io          = type(rawget(_G, "io")) == "table",
        has_os          = type(rawget(_G, "os")) == "table",
        has_string_fmt  = type(rawget(_G, "string")) == "table"
                          and type(string.format) == "function",
        has_pcall       = type(rawget(_G, "pcall")) == "function",
        has_require     = type(rawget(_G, "require")) == "function",
    }
    -- Deteksi Pluto lewat fungsi khas (bukan menebak dari nama saja)
    local pluto_markers = 0
    local markers = { "pluto_class", "pluto_switch", "pluto_continue", "pluto_enum" }
    for i = 1, #markers do
        if rawget(_G, markers[i]) ~= nil then pluto_markers = pluto_markers + 1 end
    end
    info.pluto_marker_count = pluto_markers
    return info
end

--- Mengembalikan daftar kunci _G yang terurut. Aman terhadap __pairs yang error.
local function collect_globals(limit)
    local keys = {}
    local ok, err = pcall(function()
        for k in pairs(_G) do
            keys[#keys + 1] = k
        end
    end)
    if not ok then
        return {}, "iterasi _G gagal: " .. tostr(err)
    end
    table.sort(keys, function(a, b) return tostr(a) < tostr(b) end)
    if limit and #keys > limit then
        local trimmed = {}
        for i = 1, limit do trimmed[i] = keys[i] end
        return trimmed, nil, #keys
    end
    return keys, nil, #keys
end

--- Mendaftar member sebuah tabel sedalam 1 level.
--  HANYA membaca; tidak ada pemanggilan fungsi, tidak ada akses metatable.
local function describe_table(name, tbl, limit)
    if type(tbl) ~= "table" then return nil end
    local rows = {}
    local ok, err = pcall(function()
        for k, v in pairs(tbl) do
            rows[#rows + 1] = { key = tostr(k), kind = type(v) }
            if limit and #rows >= limit then break end
        end
    end)
    if not ok then
        return nil, "enumerasi " .. tostr(name) .. " gagal: " .. tostr(err)
    end
    table.sort(rows, function(a, b) return a.key < b.key end)
    return rows
end

-- Daftar HIPOTESIS — ini BUKAN klaim bahwa nama-nama ini ada.
-- Skrip hanya mengetes keberadaannya. Hasil cetakannya adalah satu-satunya
-- bukti. Ganti daftar ini dengan nama asli dari _docs.pluto milikmu.
local HYPOTHESES = {
    { "OWH",         "namespace utama helper" },
    { "owh",         "namespace utama (huruf kecil)" },
    { "memory",      "akses memori" },
    { "process",     "akses proses" },
    { "hooks",       "manajemen hook" },
    { "hook",        "pemasangan hook" },
    { "game",        "state game" },
    { "player",      "state pemain" },
    { "loot",        "state loot" },
    { "Log",         "logger host" },
    { "console",     "konsol host" },
}

--------------------------------------------------------------------------------
-- 3b. API OWH YANG SUDAH TERBUKTI ADA
--------------------------------------------------------------------------------
-- SUMBER BUKTI: output konsol OWH 2026-10-12 (Pluto 0.12.2 / Lua 5.4).
-- Dua puluh lima nama di bawah ini BUKAN tebakan — mereka tercetak oleh
-- Bagian A1 pada runtime OWH milikmu sendiri.
--
-- Yang BELUM diketahui dan karena itu TIDAK disediakan di sini:
--   * bentuk parameter/return dari owh.hook, owh.find_pattern, owh.protect
--   * signature AoB / offset untuk fungsi loot game
--   * struktur memori loot
-- Ketiganya sengaja dikosongkan. Mengisinya dengan karangan melanggar
-- persyaratan "jangan mengarang alamat/signature/offset/struktur".
--------------------------------------------------------------------------------

local OWH_API = {
    -- { nama, kelas }
    -- kelas "read"    : hanya membaca memori            -> diizinkan via flag
    -- kelas "scan"    : informasi / pemindaian          -> diizinkan via flag
    -- kelas "write"   : MENGUBAH memori proses          -> DILARANG
    -- kelas "control" : aliran eksekusi / proteksi      -> DILARANG
    -- kelas "ui"      : antarmuka                       -> DILARANG
    --
    -- SUMBER: _docs.pluto (diberikan 2026-10-12) + output konsol OWH.
    -- 33 anggota. Versi 1.1.0 hanya mencatat 25 karena daftar awalnya
    -- terpotong oleh batas cetak; 8 sisanya terdeteksi sebagai
    -- "TIDAK TERCATAT" — deteksinya bekerja, katalognya yang kurang.

    -- Pemindaian & informasi (3)
    { "base",          "scan"    },  -- -> alamat dasar Warframe.x64.exe
    { "player_base",   "scan"    },  -- -> integer | nil (nil di luar misi)
    { "find_pattern",  "scan"    },  -- (module, aob, offs) -> alamat

    -- Baca memori (12)
    { "read_float",    "read"    },
    { "read_double",   "read"    },
    { "read_int8",     "read"    },
    { "read_uint8",    "read"    },
    { "read_int16",    "read"    },
    { "read_uint16",   "read"    },
    { "read_int32",    "read"    },
    { "read_uint32",   "read"    },
    { "read_int64",    "read"    },
    { "read_uint64",   "read"    },
    { "read_bytes",    "read"    },  -- (addr, n) -> tabel byte, 1-indexed
    { "read_string",   "read"    },  -- (addr [, maxLen]) -> string, default 4096

    -- Tulis memori (13) — DILARANG
    { "write_float",   "write"   },
    { "write_double",  "write"   },
    { "write_int8",    "write"   },
    { "write_uint8",   "write"   },
    { "write_int16",   "write"   },
    { "write_uint16",  "write"   },
    { "write_int32",   "write"   },
    { "write_uint32",  "write"   },
    { "write_int64",   "write"   },
    { "write_uint64",  "write"   },
    { "write_bytes",   "write"   },
    { "write_string",  "write"   },
    { "memcpy",        "write"   },

    -- Kontrol (4) — DILARANG
    { "hook",          "control" },  -- (addr, fn(ctx)) -> id
    { "unhook",        "control" },  -- (id)
    { "protect",       "control" },  -- (addr, size, flags) -> oldFlags | nil
    { "on_unload",     "control" },  -- (fn) saat skrip di-unload

    -- Antarmuka (1) — DILARANG
    { "msgbox",        "ui"      },
}

-- Anggota yang TIDAK BOLEH disentuh skrip ini, dalam keadaan apa pun.
local FORBIDDEN = {}
for i = 1, #OWH_API do
    local m = OWH_API[i]
    if m[2] == "write" or m[2] == "control" or m[2] == "ui" then
        FORBIDDEN[m[1]] = m[2]
    end
end

-- Penghitung akses. Dipakai untuk MEMBUKTIKAN bahwa skrip tidak memanggil
-- apa pun dari namespace owh. Bisa dibaca lewat M.get_owh_call_count().
local OWH_CALLS = { attempted = 0, executed = 0, refused = 0, log = {} }

--- Satu-satunya jalan keluar menuju namespace `owh`.
--  Menolak semua anggota kelas write/control/ui, dan mencatat setiap usaha.
--  Mengembalikan false + alasan — tidak pernah melempar.
local function safe_owh(member, ...)
    OWH_CALLS.attempted = OWH_CALLS.attempted + 1
    local host = lookup_global("owh")
    if type(host) ~= "table" then
        OWH_CALLS.refused = OWH_CALLS.refused + 1
        return false, "namespace `owh` tidak tersedia di runtime ini"
    end
    local kind = FORBIDDEN[member]
    if kind then
        OWH_CALLS.refused = OWH_CALLS.refused + 1
        OWH_CALLS.log[#OWH_CALLS.log + 1] = "DITOLAK: owh." .. tostr(member) ..
                                            " (kelas " .. kind .. ")"
        return false, "DITOLAK oleh pengaman: owh." .. tostr(member) ..
                      " adalah operasi kelas '" .. kind ..
                      "'. Skrip ini read-only dan tidak akan memanggilnya."
    end
    local fn = rawget(host, member)
    if type(fn) ~= "function" then
        OWH_CALLS.refused = OWH_CALLS.refused + 1
        return false, "owh." .. tostr(member) .. " tidak ada atau bukan function"
    end
    if not CFG.call_readonly_probes then
        OWH_CALLS.refused = OWH_CALLS.refused + 1
        return false, "pemanggilan dinonaktifkan (CFG.call_readonly_probes = false)"
    end
    OWH_CALLS.executed = OWH_CALLS.executed + 1
    OWH_CALLS.log[#OWH_CALLS.log + 1] = "DIPANGGIL: owh." .. tostr(member)
    return pcall(fn, ...)
end

--- Memeriksa keberadaan tiap anggota yang tercatat, TANPA memanggilnya.
--  Mengembalikan daftar { nama, kelas, ada, tipe }.
local function owh_inventory()
    local rows, seen = {}, {}
    local host = lookup_global("owh")
    if type(host) ~= "table" then host = nil end
    -- 1. semua yang tercatat di OWH_API
    for i = 1, #OWH_API do
        local name, kind = OWH_API[i][1], OWH_API[i][2]
        seen[name] = true
        rows[#rows + 1] = {
            name = name, kind = kind,
            present = host ~= nil and rawget(host, name) ~= nil,
            vtype = host and type(rawget(host, name)) or "n/a",
        }
    end
    -- 2. anggota host yang BELUM tercatat (kalau ada yang terlewat)
    if host then
        local extra = {}
        local ok = pcall(function()
            for k in pairs(host) do
                if not seen[k] then extra[#extra + 1] = tostr(k) end
            end
        end)
        if ok then
            table.sort(extra)
            for i = 1, #extra do
                rows[#rows + 1] = {
                    name = extra[i], kind = "TIDAK TERCATAT",
                    present = true, vtype = type(rawget(host, extra[i])),
                }
            end
        end
    end
    return rows
end

--- Mengetes hipotesis: ADA atau TIDAK ADA. Tidak pernah memanggil apa pun.
local function probe_hypotheses()
    local results = {}
    for i = 1, #HYPOTHESES do
        local name, note = HYPOTHESES[i][1], HYPOTHESES[i][2]
        local v = lookup_global(name)
        local t = type(v)
        local members = nil
        if t == "table" then
            local rows, err = describe_table(name, v, CFG.member_limit)
            if rows and #rows > 0 then
                local parts = {}
                for j = 1, #rows do
                    parts[#parts + 1] = rows[j].key .. ":" .. rows[j].kind
                end
                members = table.concat(parts, ", ")
            elseif err then
                members = "<enumerasi gagal>"
            end
        end
        results[#results + 1] = {
            name = name, note = note,
            present = (v ~= nil), kind = t, members = members,
        }
    end
    return results
end

--------------------------------------------------------------------------------
-- 4. BAGIAN B — MODEL REGISTER 32-BIT (bukan memori game)
--------------------------------------------------------------------------------

--- Memotong angka ke lebar 32-bit signed, persis seperti yang terjadi bila
--  nilai disimpan ke register 32-bit (mis. R12D) pada x86-64.
--  Fakta arsitektur: operasi 32-bit pada x86-64 akan menolkan bit 32..63 dari
--  register 64-bit induknya (zero-extend), sehingga R12D dan R12 bernilai sama
--  selama nilainya positif dan < 2^31.
local function wrap32(x)
    local n, err = toint(x)
    if not n then return nil, err end
    n = n - math.floor(n / TWO_32) * TWO_32      -- modulo 2^32 -> [0, 2^32-1]
    if n >= TWO_31 then n = n - TWO_32 end       -- -> signed [-2^31, 2^31-1]
    return n
end

--- Meniru `imul r32, r32, imm` / `imul r32, [imm]` (signed 32-bit).
--  Mengembalikan nilai terpotong + flag "wrapped" bila terjadi overflow.
local function imul_r32(value, m)
    local v, err = wrap32(value)
    if not v then return nil, nil, err end
    local mm, err2 = toint(m)
    if not mm then return nil, nil, err2 end
    if mm == 0 then return 0, false end
    local product = v * mm
    local truncated = wrap32(product)
    return truncated, (product < -TWO_31 or product > TWO_31 - 1)
end

--- Nilai maksimum yang masih aman dikalikan m tanpa overflow signed 32-bit.
local function overflow_threshold(m)
    local mm, err = toint(m)
    if not mm or mm == 0 then return nil, err or "multiplier nol" end
    return math.floor((TWO_31 - 1) / math.abs(mm))
end

--- Meniru pembacaan 16-bit (R12W) dan 8-bit (R12B) untuk perbandingan.
local function wrap16(x)
    local n = wrap32(x); if not n then return nil end
    n = n - math.floor(n / 65536) * 65536
    if n >= 32768 then n = n - 65536 end
    return n
end

--------------------------------------------------------------------------------
-- 5. BAGIAN C — SIMULATOR x2..x5 (model matematika murni)
--------------------------------------------------------------------------------

-- Data contoh SINTETIS. Ini BUKAN data drop Warframe yang sesungguhnya.
-- Ganti dengan hasil observasimu sendiri. Sengaja memakai nama generik agar
-- tidak ada klaim palsu tentang nama item / rate drop asli.
local SAMPLE_DROPS = {
    { id = "DROP_A", amount = 100, chance = 1.00, note = "sintetis: selalu drop" },
    { id = "DROP_B", amount =   1, chance = 0.25, note = "sintetis: jarang"     },
    { id = "DROP_C", amount =  15, chance = 0.60, note = "sintetis: umum"       },
    { id = "DROP_D", amount = 250, chance = 0.05, note = "sintetis: langka"     },
}

--- Memvalidasi satu entri drop. Mengembalikan true|false, pesan.
local function validate_drop(d)
    if type(d) ~= "table" then return false, "entri drop bukan tabel" end
    local amt = tonumber(d.amount)
    if amt == nil then return false, "field 'amount' wajib berupa angka" end
    if amt < 0 then return false, "field 'amount' tidak boleh negatif" end
    local ch = d.chance
    if ch ~= nil then
        ch = tonumber(ch)
        if ch == nil then return false, "field 'chance' harus angka bila ada" end
        if ch < 0 or ch > 1 then return false, "field 'chance' harus dalam [0,1]" end
    end
    return true, nil
end

--- Model 1: PERKALIAN KUANTITAS —yang dilakukan oleh sebuah imul pada register
--  yang (diduga) memuat jumlah loot. amount' = amount * m, dengan pemotongan
--  32-bit signed opsional dan clamp terhadap cap bila diketahui.
local function sim_quantity(drop, m, use_reg_model, cap)
    local ok, err = validate_drop(drop)
    if not ok then return nil, err end
    local amt = math.floor(tonumber(drop.amount))
    local base, wrapped = amt, false
    local result
    if use_reg_model then
        result, wrapped = imul_r32(amt, m)
    else
        result = amt * m
    end
    if not result then return nil, "kegagalan aritmetika pada model register" end
    local capped = false
    if type(cap) == "number" and result > cap then
        result, capped = cap, true
    end
    return {
        id = drop.id, base = base, multiplier = m, result = result,
        wrapped = wrapped, capped = capped,
    }
end

--- Model 2: PERKALIAN PELUANG — operasi yang BERBEDA secara fundamental.
--  Menggandakan *chance* bukan *amount*: P(>=1 sukses dalam m kesempatan).
--  Dipakai untuk menunjukkan bahwa "loot multiplier" adalah istilah ambigu.
local function sim_chance(drop, m)
    local ok, err = validate_drop(drop)
    if not ok then return nil, err end
    local p = tonumber(drop.chance) or 1.0
    -- Catatan portabilitas: math.pow DIHAPUS di Lua 5.3+, jadi dipakai
    -- operator pangkat `^` yang valid di Lua 5.1 s.d. 5.5 dan Pluto.
    local p_any = 1 - ((1 - p) ^ m)          -- P(minimal satu) dalam m percobaan
    if p_any < 0 then p_any = 0 end
    if p_any > 1 then p_any = 1 end
    return { id = drop.id, p_base = p, multiplier = m, p_any = p_any }
end

--- Nilai harapan (expected value) per drop dan total untuk N kejadian.
local function expected_value(drop, m, trials)
    local ok, err = validate_drop(drop)
    if not ok then return nil, err end
    local amt = tonumber(drop.amount)
    local p   = tonumber(drop.chance) or 1.0
    trials = tonumber(trials) or 1
    local per = p * amt * m
    return { id = drop.id, per_event = per, over_n = per * trials, trials = trials }
end

