    log("debug / io / os       : %s / %s / %s",
        tostr(i.has_debug), tostr(i.has_io), tostr(i.has_os))
    log("string.format / pcall : %s / %s", tostr(i.has_string_fmt), tostr(i.has_pcall))
    log("require               : %s", tostr(i.has_require))
    log("sink output terdeteksi: %d", #init_sinks())
