end

local function print_hypotheses()
    header("A1. PROBE HIPOTESIS GLOBAL (bukan klaim API)")
    log("Daftar ini HANYA dites keberadaannya. Tidak ada fungsi yang dipanggil.")
    rule()
    local r = probe_hypotheses()
    for i = 1, #r do
        if r[i].present then
            log("[ADA]      %-10s (%s)", r[i].name, r[i].kind)
            if r[i].members then log("            member: %s", r[i].members) end
        else
            log("[TIDAK ADA] %-9s  -- %s", r[i].name, r[i].note)
        end
    end
    rule()
    local found = 0
    for i = 1, #r do if r[i].present then found = found + 1 end end
    if found == 0 then
        log("Kesimpulan: tidak ada satu pun hipotesis yang cocok. Runtime ini")
        log("tidak mengekspos API publik di nama-nama tersebut. Temukan nama")
        log("aslinya lewat dump _G di bawah.")
    else
        log("Kesimpulan: %d dari %d hipotesis ADA. Namespace host ditemukan.",
            found, #r)
        log("Rincian klasifikasi dan pengaman ada di Bagian A1b dan A1c.")
    end
end

--- Laporan kemampuan berdasarkan API yang SUDAH TERBUKTI ada.
--  Bagian ini menjawab: "OWH punya primitifnya, lalu kenapa tidak dipakai?"
local function print_owh_capability()
    header("A1b. API OWH — INVENTARIS + KLASIFIKASI (bukti dari runtime-mu)")

    local host = lookup_global("owh")
    if type(host) ~= "table" then
        log("Namespace `owh` TIDAK ditemukan di runtime ini.")
        log("Bagian ini hanya terisi bila skrip dijalankan di dalam OWH.")
        return
    end

    local rows = owh_inventory()
    local n_read, n_write, n_ctrl, n_meta, n_ui, n_new = 0, 0, 0, 0, 0, 0
    log("%-16s %-16s %-10s %s", "anggota", "kelas", "ada?", "tipe")
    rule()
    for i = 1, #rows do
        local r = rows[i]
        log("  %-14s %-16s %-10s %s", r.name, r.kind, tostr(r.present), r.vtype)
        if r.present then
            if     r.kind == "read"           then n_read  = n_read  + 1
            elseif r.kind == "write"          then n_write = n_write + 1
            elseif r.kind == "control"        then n_ctrl  = n_ctrl  + 1
            elseif r.kind == "scan"           then n_meta  = n_meta  + 1
            elseif r.kind == "ui"             then n_ui    = n_ui    + 1
            elseif r.kind == "TIDAK TERCATAT" then n_new   = n_new   + 1
            end
        end
    end
    rule()
    log("ringkasan: read=%d  scan=%d  write=%d  control=%d  ui=%d  tidak-tercatat=%d",
        n_read, n_meta, n_write, n_ctrl, n_ui, n_new)
    rule()

    log("VERDIKT KEMAMPUAN (jujur, tanpa dibuat-buat):")
    log("  [TERBUKTI] OWH mengekspos primitif baca memori, TULIS memori,")
    log("             pemasangan hook, dan pencarian pola.")
    log("             Artinya pernyataan 'tidak mungkin karena API tidak")
    log("             menyediakan' TIDAK lagi berlaku untuk runtime-mu.")
    log("")
    log("  [BELUM TERBUKTI] dan karena itu tidak saya isi:")
    log("    1. bentuk parameter & return owh.hook / owh.find_pattern.")
    log("       Menebaknya = mengarang API. Butuh _docs.pluto.")
    log("    2. signature AoB / offset fungsi loot game.")
    log("       Menebaknya = mengarang alamat. Butuh RE yang bisa diulang.")
    log("    3. apakah nilai yang dikalikan benar-benar sampai ke inventori.")
    log("       Ini item G2/G4 di Bagian D1 — belum ada buktinya.")
    log("")
    log("  [BATAS YANG SENGAJA DIPEGANG]")
    log("    Skrip ini TIDAK memanggil owh.write_*, owh.memcpy, owh.hook,")
    log("    owh.unhook, owh.protect, owh.on_unload, owh.msgbox — walau semua")
    log("    itu tersedia. Alasannya: persyaratanmu nomor 7 melarangnya, dan")
    log("    mengubah perolehan loot di game multiplayer live melanggar ToS.")
    log("    Pengaman ini ditegakkan di kode, bukan cuma di komentar:")
    log("    lihat fungsi safe_owh() dan Bagian A1c.")
end

--- Pembuktian bahwa pengaman benar-benar bekerja: coba panggil SEMUA operasi
--  terlarang, lalu tunjukkan bahwa semuanya ditolak.
local function print_guard_proof()
    header("A1c. PEMBUKTIAN PENGAMAN READ-ONLY")
    log("Skrip sengaja MENCOBA memanggil SEMUA anggota terlarang untuk")
    log("membuktikan bahwa pengaman menolaknya. Tidak ada yang dieksekusi.")
    rule()
    local attempts, n = {}, 0
    for k in pairs(FORBIDDEN) do n = n + 1; attempts[n] = k end
    table.sort(attempts)
    log("anggota terlarang: %d (%d write + kontrol/UI)", n, n)
    rule()
    local refused = 0
    for i = 1, #attempts do
        local ok, res = safe_owh(attempts[i], 0, 0)
        if not ok then refused = refused + 1 end
        log("  owh.%-14s [%s] -> %s", attempts[i],
            tostr(FORBIDDEN[attempts[i]]), tostr(res))
    end
    rule()
    log("ditolak %d dari %d percobaan.", refused, #attempts)
    log("total usaha=%d | dieksekusi=%d | ditolak=%d",
        OWH_CALLS.attempted, OWH_CALLS.executed, OWH_CALLS.refused)
    if refused ~= #attempts then
        log("PERINGATAN: ada panggilan yang lolos. Matikan skrip ini sekarang.")
    else
        log("TERBUKTI: %d percobaan ditolak, 0 panggilan mutasi dieksekusi.",
            refused)
    end
end

