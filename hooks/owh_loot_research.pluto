local M = {
    MODULE  = MODULE,
    VERSION = VERSION,
    CFG     = CFG,

    -- util aman
    try     = try,
    tostr   = tostr,
    toint   = toint,
    log     = log,

    -- model register
    wrap32              = wrap32,
    wrap16              = wrap16,
    imul_r32            = imul_r32,
    overflow_threshold  = overflow_threshold,

    -- simulator
    sim_quantity        = sim_quantity,
    sim_chance          = sim_chance,
    expected_value      = expected_value,
    validate_drop       = validate_drop,
    sample_drops        = SAMPLE_DROPS,

    -- diagnostik
    detect_vm           = detect_vm,
    probe_hypotheses    = probe_hypotheses,
    collect_globals     = collect_globals,
    describe_table      = describe_table,
    evidence_checklist  = evidence_checklist,
    run_selftests       = run_selftests,

    -- API OWH yang terbukti + pengaman read-only
    owh_api             = OWH_API,
    owh_inventory       = owh_inventory,
    safe_owh            = safe_owh,
    forbidden           = FORBIDDEN,

    -- analisis register & probe baca
    low32               = low32,
    with_low32          = with_low32,
    read_addr           = read_addr,
    sample_addr         = sample_addr,
    find_addr           = find_addr,
    get_owh_call_count  = function()
        return {
            attempted = OWH_CALLS.attempted,
            executed  = OWH_CALLS.executed,
            refused   = OWH_CALLS.refused,
        }
    end,

    -- akses log
    get_log             = function() return LOG.buffer end,
    get_log_text        = function() return table.concat(LOG.buffer, "\n") end,
}

--------------------------------------------------------------------------------
-- 11. ENTRY POINT
--------------------------------------------------------------------------------

--- Menjalankan seluruh rangkaian diagnostik. Aman dipanggil berulang kali.
function M.run()
    local t0 = (type(os) == "table" and type(os.clock) == "function")
               and os.clock() or nil

    log("%s v%s mulai.", MODULE, VERSION)
    log("Mode: READ-ONLY. Skrip ini tidak menyentuh memori game, register,")
    log("atau hasil drop. Ia hanya mengamati runtime dan menghitung model.")

    local ok, err = try(function()
        print_vm_info()
        print_hypotheses()
        print_owh_capability()
        print_guard_proof()
        print_documented_api()
        print_ctx_analysis()
        print_globals()
        print_register_model()
        print_width_note()
        print_simulator()
        print_chance_model()
        print_expected_value()
        print_checklist()
        print_error_demos()
        if CFG.run_selftest then run_selftests() end
    end)

    if not ok then
        -- Jangan pernah membiarkan error menghentikan pemuatan hook.
        log("FATAL di dalam M.run(): %s", tostr(err))
        log("Skrip tetap dimuat. Perbaiki bagian yang error, lalu Reload List.")
    end

    header("G1. PENUTUP — STATUS YANG HARUS DIBEDAKAN")
    log("(1) RUNTIME   : skrip selesai dieksekusi = %s", tostr(ok))
    log("(2) DIAGNOSTIK: lihat Bagian A0..F1 di atas (ini data, bukan aksi).")
    log("(3) GAMEPLAY  : TIDAK ADA perubahan. Tidak ada loot yang berubah.")
    log("")
    log("PERTANYAAN YANG TERJAWAB:")
    log("  Q: Bisakah OWH menjalankan skrip .pluto ini?      -> Lihat (1).")
    log("  Q: Berapa hasil x2..x5 secara matematis?          -> Bagian C.")
    log("  Q: Apakah OWH mengekspos API memori/hook?         -> YA. Bagian A1b.")
    log("  Q: Apakah loot di game benar-benar x2..x5?        -> TIDAK. Titik.")
    log("")
    log("REVISI BERUNTUN — baca urutannya, jangan dilewati:")
    log("  v1.0.0: 'tidak mungkin karena API tidak tersedia'.")
    log("          SALAH. Diambil sebelum ada bukti. Primitifnya ternyata ada.")
    log("  v1.1.0: primitif terbukti ada, tapi parameter owh.hook belum jelas,")
    log("          dan katalog anggota saya cuma 25 (terpotong batas cetak).")
    log("  v1.2.0: _docs.pluto diterima -> P2 SELESAI, parameter terdokumentasi.")
    log("          Katalog diperbaiki jadi 33 anggota.")
    log("")
    log("  Yang tersisa BUKAN lagi masalah dokumentasi API:")
    log("    a) P3 — signature/offset fungsi loot masih kosong, dan _docs.pluto")
    log("       tidak menyebut loot sama sekali.")
    log("    b) G1..G4 — belum ada bukti bahwa nilai yang dikali sampai ke")
    log("       inventori dan tidak direkonsiliasi server.")
    log("    c) dan terutama: mengubah loot di game live melanggar ToS serta")
    log("       persyaratanmu sendiri nomor 7.")
    local n_forbidden = 0
    for _ in pairs(FORBIDDEN) do n_forbidden = n_forbidden + 1 end
    log("  Skrip ini tetap read-only — dibuktikan oleh Bagian A1c:")
    log("  %d anggota mutasi dicoba, %d dieksekusi.", n_forbidden,
        OWH_CALLS.executed)
    log("")
    log("PERTANYAAN YANG BELUM TERJAWAB (butuh bukti tambahan):")
    log("  - Signature/offset fungsi loot?               -> P3, butuh RE.")
    log("     _docs.pluto sudah memberi ALAT-nya (find_pattern, hook, read_*),")
    log("     tetapi tidak menyebut loot sama sekali. Alamatnya tetap kosong.")
    log("  - Apakah R12D benar jumlah loot?              -> G1..G4.")
    log("  - Berapa cap per misi?                        -> CFG.mission_cap = nil.")
    log("  - Apakah daftar 25 anggota itu lengkap?       -> Bagian A1b, lihat")
    log("    baris 'tidak-tercatat'. Kalau >0, ada yang belum saya dokumentasikan.")

    if t0 and type(os.clock) == "function" then
        log("selesai dalam %.3f detik.", os.clock() - t0)
    end
    return ok
end

--- Opsional: simpan log ke file teks biasa (BUKAN memori game).
--  Defaultnya MATI. Nyalakan lewat CFG.write_report = true.
function M.save_report(path)
    if not CFG.write_report then
        log("save_report: dilewati (CFG.write_report = false).")
        return false, "dinonaktifkan oleh konfigurasi"
    end
    local ok, fh = pcall(io.open, path or CFG.report_path, "w")
    if not ok or not fh then
        log("save_report GAGAL membuka file: %s", tostr(fh))
        return false, tostr(fh)
    end
    local ok2, err2 = pcall(function()
        fh:write(M.get_log_text())
        fh:write("\n")
    end)
    pcall(function() fh:close() end)
    if not ok2 then
        log("save_report GAGAL menulis: %s", tostr(err2))
        return false, tostr(err2)
    end
    log("laporan disimpan ke: %s", path or CFG.report_path)
    return true
end

--------------------------------------------------------------------------------
-- 12. AUTO-RUN + PENANGANAN ERROR TINGKAT ATAS
--------------------------------------------------------------------------------

-- Bungkus auto-run agar skrip tidak pernah merusak sesi hook OWH.
-- Cara mematikan auto-run (pilih salah satu):
--   1) ubah CFG.run_on_load menjadi false di atas, atau
--   2) set global OWH_RESEARCH_NO_AUTORUN = true sebelum skrip ini dimuat
--      (berguna untuk memuatnya sebagai pustaka dari hook lain).
if CFG.run_on_load ~= false and lookup_global("OWH_RESEARCH_NO_AUTORUN") ~= true then
    local ok, err = pcall(M.run)
    if not ok then
        -- Skenario terburuk: tetap beri tahu pengguna lewat jalur paling dasar.
        pcall(print, "[owh_loot_research] ERROR saat auto-run: " .. tostr(err))
        pcall(print, "[owh_loot_research] Skrip tidak melakukan apa pun ke game.")
    end
end

return M
