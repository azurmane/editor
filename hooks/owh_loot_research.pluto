--------------------------------------------------------------------------------
-- 3d. ANALISIS ctx.r12 vs R12D
--------------------------------------------------------------------------------


--- Mengambil 32-bit rendah dari nilai 64-bit (R12D dari R12).
local function low32(v)
    local n, err = toint(v)
    if not n then return nil, err end
    return n - math.floor(n / TWO_32) * TWO_32
end

--- Menggabungkan 32-bit rendah baru ke atas 32-bit yang sudah ada.
--  Ini ARITMETIKA register, bukan kode hook — tidak ada alamat di sini.
local function with_low32(full64, new32)
    local f, err = toint(full64)
    if not f then return nil, err end
    local n, err2 = toint(new32)
    if not n then return nil, err2 end
    local high = f - (f - math.floor(f / TWO_32) * TWO_32)  -- 32-bit atas
    local low  = n - math.floor(n / TWO_32) * TWO_32
    return high + low
end

local function print_ctx_analysis()
    header("A1e. ANALISIS ctx.r12 vs R12D (menjawab syarat #2 dan #4)")

    log("TEMUAN DARI _docs.pluto:")
    log("  * OWH mengekspos ctx.r12 — yaitu register 64-bit penuh.")
    log("  * Dokumen TIDAK menyediakan ctx.r12d, ctx.r8d, ctx.eax, dst.")
    log("    Semua register diekspos dalam lebar 64-bit.")
    log("")
    log("  Jadi 'R12D' yang kamu tanyakan = 32-bit RENDAH dari ctx.r12.")
    log("  Bukan sesuatu yang bisa diset langsung — harus dihitung.")
    rule()

    log("KONSEKUENSI PENTING (mengacu pada A1/A2 di Bagian D1):")
    log("  1. Kalau kamu menulis nilai 32-bit ke r12, x86-64 MENOLKAN")
    log("     bit 32..63. Jadi bit atas yang tadinya tidak nol akan hilang.")
    log("  2. Kalau r12 menyimpan POINTER 64-bit dan kamu hanya memotong")
    log("     32-bit rendahnya, pointer itu HANCUR. Ini alasan kuat")
    log("     mengapa G1/G2 wajib dibuktikan lebih dulu.")
    log("  3. Menulis 32-bit rendah tanpa merusak bit atas butuh operasi")
    log("     masking, bukan sekadar perkalian.")
    rule()

    local demo_full = 0x0000000100000064     -- contoh: bit atas = 1, bawah = 100
    local demo_low  = low32(demo_full)
    log("CONTOH ARITMETIKA (murni hitungan, tidak menyentuh game):")
    log("  nilai 64-bit penuh : %d  (bit atas=1, 32-bit rendah=100)", demo_full)
    log("  low32 (R12D)       : %s", tostr(demo_low))
    local newv = with_low32(demo_full, 300)
    log("  ganti rendah jadi 300, bit atas dipertahankan -> %s", tostr(newv))
    log("  bandingkan: mengalikan SELURUH nilai 64-bit ikut mengubah bit atas")
    log("              (contoh: %d x3 = %d)  <-- bukan yang diinginkan",
        demo_full, demo_full * 3)
    rule()

    log("CATATAN TAMBAHAN DARI DOKUMEN:")
    log("  * ctx.xmm0..xmm15 diekspos sebagai float 32-bit rendah.")
    log("    Kalau jumlah loot disimpan sebagai FLOAT, maka register yang")
    log("    relevan adalah xmm, BUKAN r12. Ini harus dibuktikan dulu.")
    log("  * ctx.skip = true melewati kode asli. Dokumen tidak menjelaskan")
    log("    apa yang terjadi pada argumen/stack bila dipakai sembarangan.")
    log("  * Tidak ada dokumentasi tentang flag CPU (OF/CF/ZF). Padahal A3")
    log("    di Bagian D1 menyebut imul mengubah flag — jadi tidak ada cara")
    log("    yang TERDOKUMENTASI untuk memulihkannya lewat API ini.")
    rule()
    log("KESIMPULAN: API-nya memberi AKSES ke r12, tetapi tidak memberi")
    log("BUKTI bahwa r12 berisi jumlah loot. Akses ≠ pemahaman.")
end

--------------------------------------------------------------------------------
-- 3e. PROBE BACA (read-only) — dipakai untuk menguji G1..G4 secara sah
--------------------------------------------------------------------------------

--- Membaca memori HANYA lewat fungsi kelas "read".
--  Alamat WAJIB diberikan pemanggil (hasil RE-mu sendiri). Skrip ini
--  tidak pernah menyediakan, mencari, atau menebak alamat.
local function read_addr(addr, width)
    if not CFG.call_readonly_probes then
        return nil, "probe baca dinonaktifkan (CFG.call_readonly_probes = false)"
    end
    local a, err = toint(addr)
    if not a then return nil, err end
    if a <= 0 then return nil, "alamat harus bilangan bulat positif" end

    local fname = "read_" .. tostr(width or "int32")
    local kind = nil
    for i = 1, #OWH_API do
        if OWH_API[i][1] == fname then kind = OWH_API[i][2] break end
    end
    if kind ~= "read" then
        return nil, "lebar '" .. tostr(width) ..
                    "' tidak dikenal. Pilih: int8/uint8/int16/uint16/" ..
                    "int32/uint32/int64/uint64/float/double"
    end
    local ok, val = safe_owh(fname, a)
    if not ok then return nil, val end
    return val
end

--- Mengambil N sampel dari satu alamat untuk melihat apakah nilainya
--  berubah — cara yang sah untuk menguji G3 (satu kali per kejadian).
--  PERINGATAN: memblokir sebentar. Jangan dipakai di dalam callback hook.
local function sample_addr(addr, width, passes)
    local n, err = toint(passes or 10)
    if not n then return nil, err end
    if n < 1 or n > 600 then
        return nil, "passes harus antara 1 dan 600"
    end
    local samples, seen, distinct = {}, {}, 0
    for i = 1, n do
        local v, e = read_addr(addr, width)
        if v == nil then
            return nil, "sampel " .. i .. " gagal: " .. tostr(e)
        end
        samples[i] = v
        if seen[tostr(v)] == nil then
            seen[tostr(v)] = true
            distinct = distinct + 1
        end
    end
    return { samples = samples, distinct = distinct, count = n }
end

--- Pindai signature — kelas "scan", tidak mengubah apa pun.
--  Argumen (module, aob, offs) WAJIB dari hasil RE-mu sendiri.
local function find_addr(module_name, aob, offs)
    if not CFG.call_readonly_probes then
        return nil, "pemindaian dinonaktifkan (CFG.call_readonly_probes = false)"
    end
    if type(module_name) ~= "string" or type(aob) ~= "string" then
        return nil, "module dan aob harus berupa string"
    end
    local ok, res = safe_owh("find_pattern", module_name, aob, offs or 0)
    if not ok then return nil, res end
    return res
end

local function print_globals()
    header("A2. INVENTARIS GLOBAL _G (bukti utama)")
    local keys, err, total = collect_globals(CFG.dump_limit)
    if err then
        log("GAGAL membaca _G: %s", err)
        return
    end
    log("total global: %d | dicetak: %d (batas dump_limit=%d)",
        total or #keys, #keys, CFG.dump_limit)
    rule()
    for i = 1, #keys do
        local k = keys[i]
        local v, t = rawget(_G, k), "?"
        local ok, vt = pcall(function() return type(rawget(_G, k)) end)
        if ok then t = vt end
        local extra = ""
        if t == "table" then
            local rows, e2 = describe_table(k, v, 8)   -- 8 agar dump _G tetap ringkas
            if rows and #rows > 0 then
                local p = {}
                for j = 1, #rows do p[#p + 1] = rows[j].key .. ":" .. rows[j].kind end
                extra = "  { " .. table.concat(p, ", ") ..
                        ((#rows >= 8) and ", ..." or "") .. " }"
            elseif e2 then
                extra = "  { <tidak dapat dienumerasi> }"
            end
        elseif t == "string" then
            local ok2, sv = pcall(function() return rawget(_G, k) end)
            if ok2 and type(sv) == "string" then
                extra = "  = " .. string.sub(tostr(sv), 1, 40)
            end
        end
        log("  %-22s %-10s%s", tostr(k), t, extra)
    end
    if total and total > #keys then
        log("  ... %d entri lagi tidak dicetak (naikkan CFG.dump_limit).", total - #keys)
    end
    rule()
    log("Salin daftar di atas. Itulah API yang SEBENARNYA tersedia di OWH-mu.")
    log("Kirim ke saya dan saya akan menyesuaikan skrip ke nama yang nyata.")
end

local function print_register_model()
    header("B1. MODEL imul PADA REGISTER 32-BIT (R12D) — untuk tiap x2..x5")
    log("Catatan: ini ARITMETIKA, bukan pembacaan memori game.")
    rule()
    log("%-10s %-16s %-16s %-12s %s",
        "input", "keluar (nil)", "32-bit signed", "overflow?", "ambang aman")
    rule()
    local samples = { 1, 15, 100, 250, 1000, 100000, 1000000000, 2147483647 }
    for _, m in ipairs(CFG.multipliers) do
        local thr = overflow_threshold(m)
        log("-- multiplier x%d | nilai maks aman sebelum wrap: %s", m, tostr(thr))
        for i = 1, #samples do
            local v = samples[i]
            local res, wrapped, err = imul_r32(v, m)
            if err then
                log("   %-10s ERROR: %s", tostr(v), err)
            else
                log("   %-10d %-16s %-16s %-12s %s",
                    v, tostr(v * m), tostr(res), tostr(wrapped), tostr(thr))
            end
        end
    end
    rule()
    log("BACA INI:")
    log("  * Kolom 'keluar (nil)' = yang diharapkan pengguna awam.")
    log("  * Kolom '32-bit signed'= yang SESUNGGUHNYA tersisa di R12D.")
    log("  * Bila 'overflow?' = true, nilainya MEMBALIK TANDA atau terpotong.")
    log("    Contoh: 1000000000 x3 = 3000000000 -> %s", tostr((imul_r32(1000000000, 3))))
    log("  * imul juga MENGUBAH FLAG OF/CF. Bila setelah titik hook ada jo/jc,")
    log("    cabang itu bisa berubah perilaku -> bug/crash, bukan cuma angka.")
end

local function print_width_note()
    header("B2. LEBAR REGISTER: mengapa R12D tidak sama dengan R12W / R12B")
    local v = 70000
    log("nilai contoh: %d", v)
    log("  sebagai R12D (32-bit signed) : %s", tostr(wrap32(v)))
    log("  sebagai R12W (16-bit signed) : %s  <-- terpotong!", tostr(wrap16(v)))
    log("  sebagai R12B ( 8-bit signed) : %s  <-- terpotong!",
        tostr((function(x) x = wrap32(x); x = x - math.floor(x / 256) * 256
            if x >= 128 then x = x - 256 end; return x end)(v)))
    rule()
    log("Implikasinya: menyebut 'R12' tanpa sufiks itu ambigu. R12D, R12W, R12B,")
    log("dan R12 adalah empat hal berbeda dengan rentang berbeda. Klaim bahwa")
    log("'R12D adalah jumlah loot' harus menyebut lebarnya secara eksplisit.")
end

local function print_simulator()
    header("C1. SIMULATOR x2..x5 — MODEL KUANTITAS (apa yang imul lakukan)")
    log("Data: SINTETIS (bukan drop rate Warframe yang asli). Ganti di SAMPLE_DROPS.")
    rule()
    log("%-8s %8s %5s %14s %10s %8s", "id", "base", "x", "hasil", "overflow", "cap?")
    rule()
    for _, m in ipairs(CFG.multipliers) do
        for i = 1, #SAMPLE_DROPS do
            local ok, res, msg = pcall(sim_quantity, SAMPLE_DROPS[i], m, true, CFG.mission_cap)
            if ok and res then
                log("%-8s %8d %5d %14s %10s %8s",
                    tostr(res.id), res.base, m, tostr(res.result),
                    tostr(res.wrapped), tostr(res.capped))
            else
                -- ok=false -> msg berisi error Lua; ok=true,res=nil -> msg=alasan
                log("%-8s  ERROR: %s", SAMPLE_DROPS[i].id, tostr(ok and msg or res))
            end
        end
        rule()
    end
end

local function print_chance_model()
    header("C2. SIMULATOR x2..x5 — MODEL PELUANG (operasi yang BERBEDA)")
    log("Ini menunjukkan bahwa istilah 'loot multiplier' itu ambigu.")
    log("imul pada register mengubah JUMLAH, bukan PELUANG.")
    rule()
    log("%-8s %10s %5s %14s", "id", "p dasar", "x", "P(>=1)")
    rule()
    for _, m in ipairs(CFG.multipliers) do
        for i = 1, #SAMPLE_DROPS do
            local ok, res, msg = pcall(sim_chance, SAMPLE_DROPS[i], m)
            if ok and res then
                log("%-8s %10.4f %5d %14.4f", tostr(res.id), res.p_base, m, res.p_any)
            else
                log("%-8s  ERROR: %s", SAMPLE_DROPS[i].id, tostr(ok and msg or res))
            end
        end
        rule()
    end
    log("Perhatikan: menggandakan peluang TIDAK pernah memberi hasil linear")
    log("(dibatasi 100%%), sedangkan menggandakan jumlah linear tapi bisa wrap.")
end

local function print_expected_value()
    header("C3. NILAI HARAPAN (expected value) — 100 kejadian")
    log("%-8s %5s %16s %16s", "id", "x", "per kejadian", "total x100")
    rule()
    for _, m in ipairs(CFG.multipliers) do
        for i = 1, #SAMPLE_DROPS do
            local ok, res, msg = pcall(expected_value, SAMPLE_DROPS[i], m, 100)
            if ok and res then
                log("%-8s %5d %16.2f %16.2f", tostr(res.id), m, res.per_event, res.over_n)
            else
                log("%-8s  ERROR: %s", SAMPLE_DROPS[i].id, tostr(ok and msg or res))
            end
        end
        rule()
    end
end

local function print_checklist()
    header("D1. CHECKLIST ALUR DATA — APA YANG TERBUKTI vs BELUM")
    local items = evidence_checklist()
    for i = 1, #items do
        log("[%s] %-6s (%s)", items[i].status, items[i].id, items[i].scope)
        log("     klaim : %s", items[i].claim)
        log("     uji   : %s", items[i].test)
        rule()
    end
    log("Ringkasan: A* = fakta arsitektur CPU (terbukti, universal).")
    log("           G* = klaim spesifik game (BELUM terbukti tanpa source/RE).")
    log("Selama G1..G4 belum lulus uji, menyebut R12D sebagai 'jumlah loot'")
    log("adalah ASUMSI, bukan fakta.")
end

--------------------------------------------------------------------------------
-- 8. BAGIAN F — DEMONSTRASI PENANGANAN ERROR
--------------------------------------------------------------------------------

local function print_error_demos()
    header("E1. DEMONSTRASI PENANGANAN ERROR (setiap kasus harus tertangkap)")
    local cases = {
        { name = "amount hilang (nil)",
          fn = function() return sim_quantity({ id = "X" }, 3, true, nil) end },
        { name = "amount bertipe string non-angka",
          fn = function() return sim_quantity({ id = "X", amount = "abc" }, 3, true, nil) end },
        { name = "amount negatif",
          fn = function() return sim_quantity({ id = "X", amount = -5 }, 3, true, nil) end },
        { name = "chance di luar [0,1]",
          fn = function() return sim_chance({ id = "X", amount = 1, chance = 7 }) end },
        { name = "multiplier = 0 (pembagi nol)",
          fn = function() return overflow_threshold(0) end },
        { name = "nilai NaN",
          fn = function() local r, _, e = imul_r32(0 / 0, 2) return r, e end },
        { name = "nilai tak hingga",
          fn = function() return wrap32(math.huge) end },
        { name = "drop bukan tabel",
          fn = function() return sim_quantity("bukan-tabel", 2, true, nil) end },
        { name = "memanggil nil sebagai fungsi",
          fn = function() return try(nil) end },
    }
    local caught = 0
    for i = 1, #cases do
        local ok, res, msg = pcall(cases[i].fn)
        -- Penanganan error dianggap benar bila SALAH SATU terjadi:
        --   a) pcall menangkap error            -> ok = false
        --   b) fungsi mengembalikan nil + pesan -> res = nil
        --   c) fungsi mengembalikan false       -> kontrak "gagal" eksplisit
        -- Kalau sebuah fungsi tetap mengembalikan nilai sukses pada input
        -- yang rusak, itu lubang validasi dan harus terlihat di sini.
        local handled = (not ok) or (res == nil) or (res == false)
        if handled then caught = caught + 1 end
        local detail
        if not ok then
            detail = "error ditangkap pcall: " .. tostr(res)
        elseif res == nil then
            detail = "nil + pesan: " .. tostr(msg)
        elseif res == false then
            detail = "nilai false: " .. tostr(msg)
        else
            detail = "MENGEMBALIKAN " .. tostr(res) .. " (validasi bocor!)"
        end
        log("  %-38s -> %-16s %s", cases[i].name,
            handled and "TERTANGKAP" or "TIDAK TERTANGKAP", detail)
    end
    rule()
    log("tertangkap %d dari %d kasus.", caught, #cases)
    if caught < #cases then
        log("PERINGATAN: ada kasus yang lolos. Perbaiki sebelum dipakai.")
    end
end

--------------------------------------------------------------------------------
-- 9. BAGIAN G — SELF-TEST
--------------------------------------------------------------------------------

local function run_selftests()
    header("F1. SELF-TEST")
    local pass, fail = 0, 0
    local function check(name, got, want)
        if got == want then
            pass = pass + 1
            log("  [OK]   %-46s = %s", name, tostr(got))
        else
            fail = fail + 1
            log("  [GAGAL] %-45s = %s (diharapkan %s)", name, tostr(got), tostr(want))
        end
    end

    check("wrap32(2147483647)", wrap32(2147483647), 2147483647)
    check("wrap32(2147483648) -> wrap", wrap32(2147483648), -2147483648)
    check("wrap32(-1)", wrap32(-1), -1)
    check("wrap32(4294967296)", wrap32(4294967296), 0)
    check("imul_r32(100, 3)", (imul_r32(100, 3)), 300)
    check("imul_r32(1e9, 3) -> signed wrap", (imul_r32(1000000000, 3)), -1294967296)
    check("imul_r32(2147483647, 2)", (imul_r32(2147483647, 2)), -2)
    check("overflow_threshold(2)", overflow_threshold(2), 1073741823)
    check("overflow_threshold(5)", overflow_threshold(5), 429496729)
    check("wrap16(70000)", wrap16(70000), 4464)

    -- model kuantitas
    local q = sim_quantity({ id = "T", amount = 100 }, 2, false, nil)
    check("sim_quantity 100 x2", q and q.result, 200)
    local q2 = sim_quantity({ id = "T", amount = 100 }, 2, false, 150)
    check("sim_quantity 100 x2 cap 150", q2 and q2.result, 150)
    check("sim_quantity cap flag", q2 and q2.capped, true)
    local q3, e3 = sim_quantity({ id = "T" }, 2, false, nil)
    check("sim_quantity amount nil -> nil+pesan", q3, nil)
    check("sim_quantity amount nil -> ada pesan", type(e3) == "string", true)

    -- model peluang
    local c = sim_chance({ id = "T", amount = 1, chance = 0.5 }, 2)
    check("sim_chance 0.5 x2 = 0.75", c and (math.floor(c.p_any * 1000 + 0.5)), 750)
    local c2 = sim_chance({ id = "T", amount = 1, chance = 0.5 }, 20)
    check("sim_chance dibatasi 1.0", c2 and c2.p_any <= 1.0, true)

    -- nilai harapan
    local ev = expected_value({ id = "T", amount = 10, chance = 0.5 }, 4, 100)
    check("EV = 0.5*10*4*100", ev and ev.over_n, 2000)

    rule()
    log("self-test: %d lulus, %d gagal", pass, fail)
    return pass, fail
end

